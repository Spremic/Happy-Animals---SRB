<!DOCTYPE html>
<html lang="sr" id="html">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= product ? product.title + ' - Happy Animals' : 'Proizvod - Happy Animals' %></title>
    
    <!-- Resource Hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://code.jquery.com" />
    
    <!-- Critical CSS -->
    <link rel="preload" href="/css/clone.css" as="style" />
    <link rel="preload" href="/css/index.css" as="style" />
    <link rel="preload" href="/css/product.css" as="style" />
    <link rel="stylesheet" href="/css/clone.css" />
    <link rel="stylesheet" href="/css/index.css" />
    <link rel="stylesheet" href="/css/product.css" />
    <link rel="stylesheet" href="/css/loader.css" />
    
    <!-- External CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" defer></script>
  </head>
  <body id="body">
    <!-- Page Loader -->
    <div id="page-loader">
      <div class="loader-content">
        <div class="loader-logo">
          <svg class="loader-paw" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor">
            <path d="M226.5 92.9c14.3 42.9-.3 86.2-32.6 96.8s-70.1-15.6-84.4-58.5s.3-86.2 32.6-96.8s70.1 15.6 84.4 58.5zM100.4 198.6c18.9 32.4 14.3 70.1-10.2 84.1s-59.7-.9-78.5-33.3S-2.7 179.3 21.8 165.3s59.7 .9 78.5 33.3zM69.2 401.2C121.6 259.9 214.7 224 256 224s134.4 35.9 186.8 177.2c3.6 9.7 5.2 20.1 5.2 30.5v1.6c0 25.8-20.9 46.7-46.7 46.7c-11.5 0-22.9-1.4-34-4.2l-88-22c-15.3-3.8-31.3-3.8-46.6 0l-88 22c-11.1 2.8-22.5 4.2-34 4.2C84.9 480 64 459.1 64 433.3v-1.6c0-10.4 1.6-20.8 5.2-30.5zM421.8 282.7c-24.5-14-29.1-51.7-10.2-84.1s54-47.3 78.5-33.3s29.1 51.7 10.2 84.1s-54 47.3-78.5 33.3zM310.1 189.7c-32.3-10.6-46.9-53.9-32.6-96.8s52.1-69.1 84.4-58.5s46.9 53.9 32.6 96.8s-52.1 69.1-84.4 58.5z"/>
          </svg>
        </div>
        <div class="loader-text">Happy Animals</div>
        <div class="loader-progress">
          <div class="loader-progress-bar"></div>
        </div>
      </div>
    </div>

    <!-- Header ce biti dinamicki ucitan iz clone.js -->

    <main class="product-page">
      <div class="product-container" <% if (product && product.id) { %>data-product-id="<%= product.id %>"<% } %>>
        <!-- Left Column: Product Images -->
        <div class="product-images reveal-left">
          <div class="images-wrapper">
            <div class="thumbnail-container">
              <!-- Skeleton loaders will be created dynamically based on number of images from Cloudinary -->
            </div>
            
            <div class="main-image-container">
              <div class="main-image-skeleton"></div>
              <div class="main-image-error" style="display: none;">
                <div class="recommended-error-content">
                  <span class="material-symbols-outlined recommended-error-icon">image_not_supported</span>
                  <h4 class="recommended-error-title">Slika se nije učitala</h4>
                  <p class="recommended-error-message">Imamo problema sa učitavanjem ove slike. Molimo pokušajte ponovo kasnije.</p>
                  <button class="recommended-error-retry">
                    <span class="material-symbols-outlined">refresh</span>
                    Pokušaj ponovo
                  </button>
                </div>
              </div>
              <img id="mainProductImage" src="" alt="<%= product ? product.title : 'Product Image' %>" class="main-image" />
              <button class="image-zoom-btn" aria-label="Uvećaj sliku">
                <span class="material-symbols-outlined">zoom_in</span>
              </button>
              <button class="image-arrow-left" aria-label="Prethodna slika">
                <span class="material-symbols-outlined">arrow_back_ios</span>
              </button>
              <button class="image-arrow-right" aria-label="Sledeća slika">
                <span class="material-symbols-outlined">arrow_forward_ios</span>
              </button>
            </div>
          </div>

          <!-- Seller Information Card -->
          <div class="seller-card reveal-left delay-200">
            <div class="seller-info">
              <div class="seller-logo">
                <img src="/img/happy animal.png" alt="Happy Animals" loading="lazy" />
                <span class="verified-badge">
                  <span class="material-symbols-outlined">verified</span>
                </span>
              </div>
              <div class="seller-details">
                <h4>Happy Animals</h4>
                <div class="seller-rating">
                  <span class="satisfied-customers">1000+ Zadovoljnih Kupaca</span>
                </div>
                <div class="seller-location">
                  <span class="material-symbols-outlined">location_on</span>
                  <span>Beograd, Srbija</span>
                </div>
              </div>
            </div>
            <button class="view-more-btn">Vidi više</button>
          </div>
        </div>

        <!-- Right Column: Product Details -->
        <div class="product-details reveal-right">
          <% if (product) { %>
            <%
              const rawVariants = Array.isArray(product.variants) && product.variants.length > 0
                ? product.variants
                : (Array.isArray(product.sizes)
                    ? product.sizes.filter(Boolean).map(s => ({
                        label: s,
                        price: Number(product.price) || 0,
                        oldPrice: product.oldPrice ? Number(product.oldPrice) : null,
                        stock: Number(product.stock) || 0
                      }))
                    : []);
              const activeVariant = rawVariants[0] || null;
              const curPrice = activeVariant ? (Number(activeVariant.price) || Number(product.price) || 0) : (Number(product.price) || 0);
              const rawOld = activeVariant ? activeVariant.oldPrice : product.oldPrice;
              const oldPriceVal = rawOld && Number(rawOld) > curPrice ? Number(rawOld) : null;
              const discPct = oldPriceVal ? Math.round(((oldPriceVal - curPrice) / oldPriceVal) * 100) + '%' : '';
              const savingsVal = oldPriceVal ? Math.round(oldPriceVal - curPrice) : 0;
              const variantTypeLabels = {
                kg: 'Težina / Pakovanje:',
                size: 'Veličina:',
                volume: 'Zapremina:',
                pieces: 'Pakovanje:',
                custom: 'Varijanta:'
              };
              const variantTitle = variantTypeLabels[product.variantType] || 'Pakovanje / Veličina:';
              const initStock = activeVariant && typeof activeVariant.stock === 'number'
                ? activeVariant.stock
                : (Number(product.stock) || 0);
              const petTypesList = Array.isArray(product.petType) ? product.petType.filter(Boolean) : [];
              const specialDietList = Array.isArray(product.specialDiet) ? product.specialDiet.filter(Boolean) : [];
              const colorHexMap = {
                crvena: '#d32f2f', plava: '#1976d2', zelena: '#2e7d32', crna: '#1c1c1c',
                bela: '#f5f5f5', zuta: '#fbc02d', 'žuta': '#fbc02d', roze: '#ec407a',
                ljubicasta: '#7b1fa2', 'ljubičasta': '#7b1fa2', siva: '#757575', braon: '#6d4c41',
                narandzasta: '#f57c00', 'narandžasta': '#f57c00', bez: '#d7ccc8', 'bež': '#d7ccc8'
              };
            %>
            <div class="product-header">
              <div class="discount-label reveal delay-100" id="productDiscountLabel" <% if (!discPct) { %>style="display: none;"<% } %>><%= discPct ? `-${discPct}` : '' %></div>
              
              <h1 class="product-title reveal delay-100"><%= product.title %></h1>

              <% if (petTypesList.length || product.lifeStage || product.flavor || specialDietList.length) { %>
                <div class="pet-meta-badges reveal delay-100">
                  <% if (petTypesList.length) { %>
                    <span class="pet-meta-badge">Ljubimac: <%= petTypesList.join(', ') %></span>
                  <% } %>
                  <% if (product.lifeStage) { %>
                    <span class="pet-meta-badge">Uzrast: <%= product.lifeStage %></span>
                  <% } %>
                  <% if (product.flavor) { %>
                    <span class="pet-meta-badge">Ukus: <%= product.flavor %></span>
                  <% } %>
                  <% specialDietList.forEach((diet) => { %>
                    <span class="pet-meta-badge diet"><%= diet %></span>
                  <% }); %>
                </div>
              <% } %>
              
              <div class="product-price-wrapper reveal delay-200">
                <div class="price-container">
                  <div class="original-price" id="productOriginalPriceRow" <% if (!oldPriceVal) { %>style="display: none;"<% } %>>
                    <span class="original-amount" id="productOriginalAmount"><%= oldPriceVal ? formatPriceString(oldPriceVal) : '' %></span>
                    <span class="original-currency">RSD</span>
                  </div>
                  <div class="current-price">
                    <span class="price-amount" id="productPriceAmount"><%= formatPriceString(curPrice) %></span>
                    <span class="price-currency">RSD</span>
                  </div>
                  <div class="savings-hint" id="productSavingsHint" <% if (!savingsVal) { %>style="display: none;"<% } %>>
                    <%= savingsVal ? `Ušteda: ${formatPriceString(savingsVal)} RSD` : '' %>
                  </div>
                </div>
              </div>
            </div>

            <% if (rawVariants.length > 0) { %>
              <div class="product-option reveal delay-200" id="variantSelectorGroup">
                <div class="option-header">
                  <span class="option-title"><%= variantTitle %></span>
                  <span class="stock-warning <%= initStock === 0 ? 'out-of-stock' : (initStock <= 5 ? 'low-stock' : '') %>" id="variantStockStatus">
                    <%= initStock > 0 ? (initStock <= 5 ? `Još samo ${initStock} na stanju` : 'Na stanju') : 'Trenutno nema na stanju' %>
                  </span>
                </div>
                <div class="size-options" id="variantOptions">
                  <% rawVariants.forEach((v, idx) => { %>
                    <%
                      const vPrice = Number(v.price) || curPrice;
                      const vOld = v.oldPrice && Number(v.oldPrice) > vPrice ? Number(v.oldPrice) : '';
                      const vStock = typeof v.stock === 'number' ? v.stock : (Number(product.stock) || 0);
                    %>
                    <button
                      type="button"
                      class="size-btn <%= idx === 0 ? 'active' : '' %>"
                      data-size="<%= v.label %>"
                      data-variant-label="<%= v.label %>"
                      data-variant-price="<%= vPrice %>"
                      data-variant-oldprice="<%= vOld %>"
                      data-variant-stock="<%= vStock %>"
                    >
                      <%= v.label %>
                    </button>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <%
              const normalizedColors = Array.isArray(product.colors)
                ? product.colors
                    .map((c) => {
                      const label = typeof c === 'string' ? c.trim() : String((c && (c.name || c.label)) || '').trim();
                      const rawHex = typeof c === 'object' && c ? String(c.hex || c.code || '').trim() : '';
                      const bgCol = (rawHex && rawHex !== '#2c2527' && rawHex.startsWith('#'))
                        ? rawHex
                        : (label.startsWith('#') ? label : (colorHexMap[label.toLowerCase()] || rawHex || '#4b5563'));
                      return label ? { label, bgCol } : null;
                    })
                    .filter(Boolean)
                : [];
            %>
            <% if (normalizedColors.length > 0) { %>
              <div class="product-option reveal delay-200" id="colorSelectorGroup">
                <div class="option-header">
                  <span class="option-title">Boja / Varijanta izgleda:</span>
                  <span class="stock-warning" id="selectedColorName"><%= normalizedColors[0].label %></span>
                </div>
                <div class="color-options">
                  <% normalizedColors.forEach((cObj, idx) => { %>
                    <button
                      type="button"
                      class="color-btn <%= idx === 0 ? 'active' : '' %>"
                      data-color="<%= cObj.label %>"
                      title="<%= cObj.label %>"
                      style="background-color: <%= cObj.bgCol %>;"
                    ></button>
                  <% }); %>
                </div>
              </div>
            <% } %>

            <!-- Description -->
            <div class="product-description reveal delay-300">
              <h3 class="description-title">Opis:</h3>
              <p class="description-text">
                <%= product.description %>
              </p>
            </div>
          <% } else { %>
            <div class="product-header">
              <h1 class="product-title reveal delay-100">Proizvod nije pronađen</h1>
              <div class="product-price-wrapper reveal delay-200">
                <div class="price-container">
                  <div class="current-price">
                    <span class="price-amount">0</span>
                    <span class="price-currency">RSD</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="product-description reveal delay-300">
              <h3 class="description-title">Opis:</h3>
              <p class="description-text">Traženi proizvod nije pronađen.</p>
            </div>
          <% } %>

          <!-- Action Buttons -->
          <div class="product-actions reveal delay-400">
            <button class="btn-buy-now" <% if (product && product.id) { %>data-product-id="<%= product.id %>"<% } %>>
              <span class="material-symbols-outlined">shopping_cart</span>
              Kupi sada
            </button>
            <button class="btn-add-cart" <% if (product && product.id) { %>data-product-id="<%= product.id %>"<% } %>>
              <span class="material-symbols-outlined">add_shopping_cart</span>
              Dodaj u korpu
            </button>
            <button class="btn-favorite" <% if (product && product.id) { %>data-product-id="<%= product.id %>"<% } %> aria-label="Dodaj u omiljene">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                <path class="heart-outline" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="none" stroke="#009900" stroke-width="2"/>
                <path class="heart-filled" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="#009900" opacity="0"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Specifications Section -->
      <section class="specifications-section">
        <h2 class="specifications-title reveal">Specifikacije</h2>
        <div class="specifications-content">
          <% if (product) { %>
            <%
              const specPetTypes = Array.isArray(product.petType) ? product.petType.filter(Boolean).join(', ') : '';
              const specSpecialDiet = Array.isArray(product.specialDiet) ? product.specialDiet.filter(Boolean).join(', ') : '';
              const specVariants = Array.isArray(product.variants) && product.variants.length > 0
                ? product.variants.map(v => `${v.label} (${formatPriceString(v.price)} RSD)`).join(' • ')
                : (Array.isArray(product.sizes) && product.sizes.length > 0 ? product.sizes.join(', ') : '');
              const catDisp = Array.isArray(product.category) ? product.category.join(', ') : product.category;
              const subDisp = Array.isArray(product.subcategory) ? product.subcategory.join(', ') : product.subcategory;
              const typeDisp = Array.isArray(product.subcategory2) && product.subcategory2.length ? product.subcategory2.join(', ') : product.type;
            %>
            <% if (product.brand) { %>
              <div class="spec-item reveal delay-100">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Brend:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= product.brand %></span>
                </div>
              </div>
            <% } %>
            <% if (specPetTypes) { %>
              <div class="spec-item reveal delay-100">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Namenjeno za:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= specPetTypes %></span>
                </div>
              </div>
            <% } %>
            <% if (product.lifeStage) { %>
              <div class="spec-item reveal delay-100">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Uzrast ljubimca:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= product.lifeStage %></span>
                </div>
              </div>
            <% } %>
            <% if (product.flavor) { %>
              <div class="spec-item reveal delay-100">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Ukus / Sastojak:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= product.flavor %></span>
                </div>
              </div>
            <% } %>
            <% if (specSpecialDiet) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Posebne karakteristike:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= specSpecialDiet %></span>
                </div>
              </div>
            <% } %>
            <% if (specVariants) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Pakovanja i cene:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= specVariants %></span>
                </div>
              </div>
            <% } %>
            <% if (product.technicalData && Array.isArray(product.technicalData.labels) && product.technicalData.labels.length > 0) { %>
              <% product.technicalData.labels.forEach((label, index) => { %>
                <div class="spec-item reveal delay-<%= Math.floor(index / 3) + 1 %>00">
                  <div class="spec-label-wrapper">
                    <span class="spec-label"><%= label %></span>
                  </div>
                  <div class="spec-value-wrapper">
                    <span class="spec-value"><%= (product.technicalData.features && product.technicalData.features[index]) || 'N/A' %></span>
                  </div>
                </div>
              <% }); %>
            <% } %>
            <% if (catDisp) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Kategorija:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= catDisp %></span>
                </div>
              </div>
            <% } %>
            <% if (subDisp) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Potkategorija:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= subDisp %></span>
                </div>
              </div>
            <% } %>
            <% if (typeDisp) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Tip proizvoda:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= typeDisp %></span>
                </div>
              </div>
            <% } %>
            <% if (product.material) { %>
              <div class="spec-item reveal delay-200">
                <div class="spec-label-wrapper">
                  <span class="spec-label">Materijal / Sastav:</span>
                </div>
                <div class="spec-value-wrapper">
                  <span class="spec-value"><%= product.material %></span>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <div class="spec-item reveal delay-100">
              <div class="spec-label-wrapper">
                <span class="spec-label">Status:</span>
              </div>
              <div class="spec-value-wrapper">
                <span class="spec-value">Proizvod nije pronađen</span>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <!-- Recommended Products Section -->
      <section class="recommended-section">
        <h3 class="recommended-title reveal">Preporučeni Proizvodi</h3>
        
        <div class="recommended-flex-container">
          <div class="recommended-arrow-l">
            <span class="material-symbols-outlined">arrow_back_ios_new</span>
          </div>

          <div class="recommended-mid-wrapper">
            <div class="recommended-mid" id="recommendedProducts">
              <!-- Skeleton loaders - shown initially, match exact card structure -->
              <div class="recommended-card recommended-skeleton-card">
                <div class="recommended-image-c">
                  <div class="recommended-image-skeleton"></div>
                </div>
                <div class="recommended-content-c">
                  <div class="recommended-skeleton-brand"></div>
                  <div class="recommended-skeleton-text"></div>
                  <div class="recommended-skeleton-text short"></div>
                  <div class="recommended-skeleton-price-container">
                    <div class="recommended-skeleton-price"></div>
                  </div>
                  <div class="recommended-skeleton-btns">
                    <div class="recommended-skeleton-btn"></div>
                    <div class="recommended-skeleton-btn-icon"></div>
                  </div>
                </div>
              </div>
              <div class="recommended-card recommended-skeleton-card">
                <div class="recommended-image-c">
                  <div class="recommended-image-skeleton"></div>
                </div>
                <div class="recommended-content-c">
                  <div class="recommended-skeleton-brand"></div>
                  <div class="recommended-skeleton-text"></div>
                  <div class="recommended-skeleton-text short"></div>
                  <div class="recommended-skeleton-price-container">
                    <div class="recommended-skeleton-price"></div>
                  </div>
                  <div class="recommended-skeleton-btns">
                    <div class="recommended-skeleton-btn"></div>
                    <div class="recommended-skeleton-btn-icon"></div>
                  </div>
                </div>
              </div>
              <div class="recommended-card recommended-skeleton-card">
                <div class="recommended-image-c">
                  <div class="recommended-image-skeleton"></div>
                </div>
                <div class="recommended-content-c">
                  <div class="recommended-skeleton-brand"></div>
                  <div class="recommended-skeleton-text"></div>
                  <div class="recommended-skeleton-text short"></div>
                  <div class="recommended-skeleton-price-container">
                    <div class="recommended-skeleton-price"></div>
                  </div>
                  <div class="recommended-skeleton-btns">
                    <div class="recommended-skeleton-btn"></div>
                    <div class="recommended-skeleton-btn-icon"></div>
                  </div>
                </div>
              </div>
              <div class="recommended-card recommended-skeleton-card">
                <div class="recommended-image-c">
                  <div class="recommended-image-skeleton"></div>
                </div>
                <div class="recommended-content-c">
                  <div class="recommended-skeleton-brand"></div>
                  <div class="recommended-skeleton-text"></div>
                  <div class="recommended-skeleton-text short"></div>
                  <div class="recommended-skeleton-price-container">
                    <div class="recommended-skeleton-price"></div>
