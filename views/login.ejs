<!DOCTYPE html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Happy Animals Admin Portal - Prijava" />

    <title>Happy Animals | Admin Prijava</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    
    <!-- Google Fonts Matching Storefront (Roboto + Baloo 2) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Classic Admin CSS (0 SCSS, 0 External Frameworks) -->
    <link href="/admin/css/admin.css?v=3.0" rel="stylesheet" />
  </head>

  <body class="login-body p-0 m-0">
    <div class="login-container">
      <div class="row no-gutters m-0 p-0 w-100 h-100">
        
        <!-- Leva kolona: Brending & Opis -->
        <div class="col-lg-4 col-md-5 d-none d-md-flex login-branding-side flex-column justify-content-center position-relative overflow-hidden">
          <div class="bg-circle" style="position: absolute; top: -10%; left: -10%; width: 400px; height: 400px; background: rgba(0, 153, 0, 0.08); border-radius: 50%;"></div>
          <div class="bg-circle" style="position: absolute; bottom: -5%; right: -5%; width: 300px; height: 300px; background: rgba(0, 153, 0, 0.12); border-radius: 50%;"></div>
          
          <div class="branding-content mx-auto position-relative" style="max-width: 400px; width: 100%; z-index: 1;">
            <div class="d-flex align-items-center mb-4">
              <div class="brand-logo-icon mr-3 mb-0" style="width: 46px; height: 46px; background: #009900; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; color: #fff;">
                <i class="fas fa-paw"></i>
              </div>
              <h1 class="brand-title mb-0 text-white" style="font-size: 1.45rem; font-weight: 800; letter-spacing: 0.5px; font-family: var(--font-heading);">HAPPY <span style="color: #009900;">ANIMALS</span></h1>
            </div>
            
            <h2 class="text-white font-weight-bold mb-3" style="font-size: 2.1rem; line-height: 1.2; font-family: var(--font-editorial);">Admin Kontrolni<br>Centar</h2>
            <p class="brand-subtitle mb-4" style="color: rgba(255,255,255,0.72); font-size: 0.95rem; line-height: 1.5; font-family: var(--font-body);">Upravljajte artiklima, brendovima, kategorijama, zalihama i pristiglim porudžbinama na jednom mestu.</p>

            <ul class="login-feature-list list-unstyled mt-3" style="list-style: none; padding-left: 0;">
              <li class="text-white-50 mb-3 d-flex align-items-center" style="font-size: 0.92rem; font-family: var(--font-body);">
                <span class="mr-3" style="color: #009900; font-size: 0.5rem;"><i class="fas fa-circle"></i></span>
                Brzi unos artikala i Drag & Drop WebP optimizacija slika
              </li>
              <li class="text-white-50 mb-3 d-flex align-items-center" style="font-size: 0.92rem; font-family: var(--font-body);">
                <span class="mr-3" style="color: #009900; font-size: 0.5rem;"><i class="fas fa-circle"></i></span>
                Upravljanje veličinama, bojama i zalihama
              </li>
              <li class="text-white-50 mb-3 d-flex align-items-center" style="font-size: 0.92rem; font-family: var(--font-body);">
                <span class="mr-3" style="color: #009900; font-size: 0.5rem;"><i class="fas fa-circle"></i></span>
                Pregled i promena statusa porudžbina kupaca
              </li>
              <li class="text-white-50 mb-3 d-flex align-items-center" style="font-size: 0.92rem; font-family: var(--font-body);">
                <span class="mr-3" style="color: #009900; font-size: 0.5rem;"><i class="fas fa-circle"></i></span>
                Maksimalna bezbednost i keširana navigacija
              </li>
            </ul>
          </div>
        </div>

        <!-- Desna kolona: Forma za prijavu -->
        <div class="col-12 col-lg-8 col-md-7 d-flex flex-column justify-content-center align-items-center login-form-side" style="background: #181515;">
          <div class="w-100" style="max-width: 440px; padding: 25px;">
            <div class="text-center mb-4">
              <h2 style="font-weight: 800; color: #ffffff; font-size: 1.85rem; margin-bottom: 6px; font-family: var(--font-heading);">Prijavite se</h2>
              <p class="text-muted" style="font-size: 0.92rem; font-family: var(--font-body);">Unesite vaše podatke za pristup administraciji</p>
            </div>

            <div id="loginAlert" class="alert alert-danger" style="display: none; border-radius: 10px; font-size: 0.9rem;"></div>

            <form id="loginForm">
              <div class="form-group mb-3">
                <label for="email" style="font-weight: 600; font-size: 0.88rem; color: #f0f0f0;">Email adresa</label>
                <div class="input-group">
                  <div class="input-group-prepend">
                    <span class="input-group-text border-right-0" style="border-radius: 10px 0 0 10px; color: #009900; background: #1e1b1b; border-color: var(--color-border);"><i class="fas fa-envelope"></i></span>
                  </div>
                  <input type="email" class="form-control border-left-0" id="email" name="mail" placeholder="admin@happyanimals.rs" required style="border-radius: 0 10px 10px 0; height: 46px; background: #1e1b1b; color: #f0f0f0; border-color: var(--color-border);" />
                </div>
              </div>

              <div class="form-group mb-4">
                <label for="password" style="font-weight: 600; font-size: 0.88rem; color: #f0f0f0;">Lozinka</label>
                <div class="input-group">
                  <div class="input-group-prepend">
                    <span class="input-group-text border-right-0" style="border-radius: 10px 0 0 10px; color: #009900; background: #1e1b1b; border-color: var(--color-border);"><i class="fas fa-lock"></i></span>
                  </div>
                  <input type="password" class="form-control border-left-0" id="password" name="password" placeholder="••••••••" required style="border-radius: 0 10px 10px 0; height: 46px; background: #1e1b1b; color: #f0f0f0; border-color: var(--color-border);" />
                </div>
              </div>

              <button type="submit" id="loginBtn" class="btn btn-primary btn-block" style="background: #009900; border: none; height: 48px; border-radius: 10px; font-weight: 700; font-size: 1rem; box-shadow: none; transition: all 0.2s ease;">
                <span id="btnText">Prijavite se</span>
                <span id="btnSpinner" class="spinner-border spinner-border-sm ml-2" style="display: none;" role="status"></span>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

    <!-- Pure Classic JS (0 Dependencies) -->
    <script src="/admin/js/login.js?v=2.6"></script>
  </body>
</html>
