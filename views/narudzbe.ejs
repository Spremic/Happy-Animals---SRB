<!DOCTYPE html>
<html lang="sr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Porudžbine | Happy Animals Admin</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    
    <!-- Google Fonts Matching Storefront (Roboto + Baloo 2) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Classic Admin Styles (0 SCSS, 0 Frameworks) -->
    <link href="/admin/css/admin.css?v=3.0" rel="stylesheet" />
  </head>

  <body id="page-top">
    <div id="wrapper">
      <ul class="sidebar" id="accordionSidebar"></ul>

      <div id="content-wrapper">
        <div id="content">
          <!-- Topbar -->
          <nav class="topbar mb-4">
            <button id="sidebarToggleTop" class="btn btn-link d-md-none" title="Meni">
              <i class="fa fa-bars"></i>
            </button>
            <ul class="navbar-nav ml-auto">
              <div class="topbar-divider d-none d-sm-block"></div>
              <li class="nav-item dropdown">
                <a class="dropdown-toggle" href="#" id="userDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <span class="mr-2 d-none d-lg-inline text-muted small font-weight-bold">Admin</span>
                  <img class="img-profile" src="/admin/img/avatar.jpg" alt="Avatar" />
                </a>
                <div class="dropdown-menu" aria-labelledby="userDropdown">
                  <a class="dropdown-item" href="/logout" id="logoutBTN">
                    <i class="fas fa-sign-out-alt fa-sm"></i> Odjavite se
                  </a>
                </div>
              </li>
            </ul>
          </nav>

          <!-- Glavni sadržaj -->
          <div class="container-fluid">
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
              <div>
                <h1 class="h3 mb-1" style="color: #ffffff; font-weight: 800; font-family: var(--font-heading);">Porudžbine kupaca</h1>
                <p class="text-muted small mb-0">Pregled, statusi i detalji pristiglih online porudžbina</p>
              </div>
            </div>

            <!-- Status Slider / Tabs za brzu selekciju svih statusa -->
            <div class="order-status-slider-container" id="orderStatusSlider">
              <button type="button" class="order-status-pill active" data-status="">
                <span class="pill-dot pill-dot-all"></span>
                <span class="pill-label">Sve porudžbine</span>
                <span class="pill-count" id="count-all">0</span>
              </button>
              <button type="button" class="order-status-pill" data-status="na_cekanju">
                <span class="pill-dot pill-dot-na_cekanju"></span>
                <span class="pill-label">Na čekanju</span>
                <span class="pill-count" id="count-na_cekanju">0</span>
              </button>
              <button type="button" class="order-status-pill" data-status="obradjeno">
                <span class="pill-dot pill-dot-obradjeno"></span>
                <span class="pill-label">Obrađeno</span>
                <span class="pill-count" id="count-obradjeno">0</span>
              </button>
              <button type="button" class="order-status-pill" data-status="poslato">
                <span class="pill-dot pill-dot-poslato"></span>
                <span class="pill-label">Poslato</span>
                <span class="pill-count" id="count-poslato">0</span>
              </button>
              <button type="button" class="order-status-pill" data-status="isporuceno">
                <span class="pill-dot pill-dot-isporuceno"></span>
                <span class="pill-label">Isporučeno</span>
                <span class="pill-count" id="count-isporuceno">0</span>
              </button>
              <button type="button" class="order-status-pill" data-status="otkazano">
                <span class="pill-dot pill-dot-otkazano"></span>
                <span class="pill-label">Otkazano</span>
                <span class="pill-count" id="count-otkazano">0</span>
              </button>
            </div>

            <!-- Filteri i pretraga -->
            <div class="card mb-4">
              <div class="card-body py-3">
                <div class="row align-items-center">
                  <div class="col-md-7 mb-2 mb-md-0">
                    <div class="input-group">
                      <input type="text" id="orderSearchInput" class="form-control" placeholder="Pretraži po broju, kupcu, gradu ili telefonu..." style="border-radius: 8px 0 0 8px;" />
                      <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" onclick="loadOrders(1)">
                          <i class="fas fa-search"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-5 text-md-right d-flex align-items-center justify-content-md-end justify-content-between">
                    <input type="hidden" id="orderStatusFilter" value="" />
                    <span id="orderActiveFilterBadge" class="badge badge-primary mr-2 p-2" style="font-size: 0.85rem; background: #009900;">Sve porudžbine</span>
                    <span id="orderTotalCount" class="badge badge-light p-2" style="font-size: 0.85rem; border: 1px solid var(--color-border); background: #1e1b1b; color: #f0f0f0;">Prikazano: 0</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tabela porudžbina -->
            <div class="card mb-4">
              <div class="card-body p-0">
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0" id="ordersTable" width="100%" cellspacing="0">
                    <thead>
                      <tr>
                        <th>Broj porudžbine</th>
                        <th>Kupac</th>
                        <th>Grad / Telefon</th>
                        <th>Datum</th>
                        <th>Artikli</th>
                        <th>Iznos</th>
                        <th>Status</th>
                        <th style="min-width: 120px; width: 120px; text-align: center; white-space: nowrap;">Akcije</th>
                      </tr>
                    </thead>
                    <tbody id="ordersList">
                      <% for(let i = 0; i < 6; i++) { %>
                      <tr class="skeleton-row">
                        <td><div class="skeleton skeleton-text" style="width: 140px; height: 16px;"></div></td>
                        <td><div class="skeleton skeleton-text" style="width: 110px; height: 15px;"></div></td>
                        <td>
                          <div class="skeleton skeleton-text" style="width: 80px; height: 14px; margin-bottom: 4px;"></div>
                          <div class="skeleton skeleton-text" style="width: 95px; height: 12px;"></div>
                        </td>
                        <td><div class="skeleton skeleton-text" style="width: 105px; height: 14px;"></div></td>
                        <td><div class="skeleton skeleton-badge" style="width: 55px;"></div></td>
                        <td><div class="skeleton skeleton-text" style="width: 85px; height: 15px;"></div></td>
                        <td><div class="skeleton skeleton-badge" style="width: 85px;"></div></td>
                        <td style="text-align: center; white-space: nowrap; min-width: 120px; width: 120px;">
                          <div class="table-action-btns" style="display: inline-flex; flex-direction: row; align-items: center; justify-content: center; gap: 8px; flex-wrap: nowrap; white-space: nowrap;">
                            <div class="skeleton skeleton-btn" style="flex: 0 0 34px; width: 34px; height: 34px;"></div>
                            <div class="skeleton skeleton-btn" style="flex: 0 0 34px; width: 34px; height: 34px;"></div>
                          </div>
                        </td>
                      </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
              <div class="card-footer d-flex align-items-center justify-content-between py-3" style="background: #181515; border-top: 1px solid var(--color-border);">
                <div id="orderPaginationInfo" class="text-muted small">Prikazano 0 od 0</div>
                <ul class="pagination pagination-sm mb-0" id="orderPaginationControls"></ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL DETALJI PORUDŽBINE (Supermedia dizajn) -->
    <div class="modal fade" id="orderDetailsModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header header-gradient">
            <h5 class="modal-title" id="orderDetailsTitle">
              <i class="fas fa-file-invoice"></i>
              <span>Detalji porudžbine <span id="orderIdDisplay" style="opacity: 0.9;"></span></span>
            </h5>
            <button type="button" class="close text-white" data-dismiss="modal" aria-label="Zatvori">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body p-4" id="orderDetailsBody" style="max-height: 82vh; overflow-y: auto; background-color: #181515;">
            <!-- Dinamički se popunjava po uzoru na Supermedia -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary px-4" data-dismiss="modal">Zatvori</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Pure Classic JS (0 Dependencies) -->
    <script src="/admin/js/clone.js?v=2.4"></script>
    <script src="/admin/js/narudzbe.js?v=2.4"></script>
  </body>
</html>
